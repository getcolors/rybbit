{
  "locals": {
    "public_ingress": {
      "http-443:0.0.0.0/0": {
        "port_range": "443",
        "protocol": "tcp",
        "source_addresses": [
          "0.0.0.0/0"
        ]
      },
      "http-443:::/0": {
        "port_range": "443",
        "protocol": "tcp",
        "source_addresses": [
          "::/0"
        ]
      },
      "http-80:0.0.0.0/0": {
        "port_range": "80",
        "protocol": "tcp",
        "source_addresses": [
          "0.0.0.0/0"
        ]
      },
      "http-80:::/0": {
        "port_range": "80",
        "protocol": "tcp",
        "source_addresses": [
          "::/0"
        ]
      },
      "http3:0.0.0.0/0": {
        "port_range": "443",
        "protocol": "udp",
        "source_addresses": [
          "0.0.0.0/0"
        ]
      },
      "http3:::/0": {
        "port_range": "443",
        "protocol": "udp",
        "source_addresses": [
          "::/0"
        ]
      },
      "ssh:0.0.0.0/0": {
        "port_range": "22",
        "protocol": "tcp",
        "source_addresses": [
          "0.0.0.0/0"
        ]
      },
      "ssh:::/0": {
        "port_range": "22",
        "protocol": "tcp",
        "source_addresses": [
          "::/0"
        ]
      }
    }
  },
  "output": {
    "compute_identity": {
      "value": {
        "node_id": "rybbit-compute",
        "profile": "rybbit-keygen-fixture",
        "provider": "digitalocean",
        "ssh_fingerprint": "SHA256:kmYcvdi2GkPeWxB6XLjrZB8JHsy2Hm8luHMFp9GMvqk",
        "ssh_resource_reference": "ssh-resource:build-placeholder",
        "state_filename": "rybbit-node-0.tfstate"
      }
    },
    "params": {
      "value": {
        "droplet_id": "${digitalocean_droplet.node.id}",
        "ip": "${digitalocean_droplet.node.ipv4_address}",
        "name": "${digitalocean_droplet.node.name}",
        "node_id": "rybbit-compute",
        "provider": "digitalocean",
        "provider_id": "${digitalocean_droplet.node.id}",
        "ssh_key_id": "0",
        "sudoer": "root",
        "user": "root",
        "vpc_ip": null
      }
    }
  },
  "provider": {
    "digitalocean": {}
  },
  "resource": {
    "digitalocean_droplet": {
      "node": {
        "image": "ubuntu-24-04-x64",
        "lifecycle": {
          "prevent_destroy": true
        },
        "name": "rybbit-keygen-fixture-rybbit-compute",
        "region": "ams3",
        "size": "s-4vcpu-8gb",
        "ssh_keys": [
          "0"
        ],
        "tags": [
          "${digitalocean_tag.deployment.name}"
        ]
      }
    },
    "digitalocean_firewall": {
      "network": {
        "dynamic": {
          "inbound_rule": [
            {
              "content": {
                "port_range": "${try(inbound_rule.value.port_range, null)}",
                "protocol": "${inbound_rule.value.protocol}",
                "source_addresses": "${inbound_rule.value.source_addresses}"
              },
              "for_each": "${local.public_ingress}"
            }
          ]
        },
        "lifecycle": {
          "prevent_destroy": true
        },
        "name": "rybbit-keygen-fixture-rybbit-compute-firewall",
        "outbound_rule": [
          {
            "destination_addresses": [
              "0.0.0.0/0",
              "::/0"
            ],
            "port_range": "1-65535",
            "protocol": "tcp"
          },
          {
            "destination_addresses": [
              "0.0.0.0/0",
              "::/0"
            ],
            "port_range": "1-65535",
            "protocol": "udp"
          },
          {
            "destination_addresses": [
              "0.0.0.0/0",
              "::/0"
            ],
            "protocol": "icmp"
          }
        ],
        "tags": [
          "${digitalocean_tag.deployment.name}"
        ]
      }
    },
    "digitalocean_reserved_ip": {
      "endpoint": {
        "count": 0,
        "lifecycle": {
          "ignore_changes": [
            "droplet_id"
          ],
          "prevent_destroy": true
        },
        "region": "ams3"
      }
    },
    "digitalocean_tag": {
      "deployment": {
        "lifecycle": {
          "prevent_destroy": true
        },
        "name": "colors-compute-rybbit-keygen-fixture-rybbit-compute"
      }
    }
  },
  "terraform": {
    "required_providers": {
      "digitalocean": {
        "source": "digitalocean/digitalocean",
        "version": "2.51.0"
      }
    },
    "required_version": ">= 1.8.0"
  }
}
