#!/usr/bin/env bash
set -euo pipefail
cd /opt/rybbit
stamp=$(date -u +%Y%m%dT%H%M%SZ)
mkdir -p <{ rybbit-backup-dir }>
tmp_dir=$(mktemp -d /tmp/rybbit-backup-XXXXXX)

# Source credentials from retained stack.env
set -a
[ -f /opt/rybbit/stack.env ] && source /opt/rybbit/stack.env
set +a

# Dump PostgreSQL
docker compose exec -T postgres pg_dump -U "${POSTGRES_USER:-rybbit}" -d "${POSTGRES_DB:-rybbit}" > "$tmp_dir/postgres.sql"

# ClickHouse's own BACKUP statement produces a consistent archive. Taring the
# data directory while the server runs races its merges -- parts vanish mid-read
# -- and yields an archive that cannot be restored, so there is deliberately no
# fallback here: a failed ClickHouse backup must fail the whole run. File()
# destinations must sit under the server's backups.allowed_path, which is on the
# bind mount and therefore visible from the host.
docker compose exec -T -u root clickhouse sh -c 'mkdir -p /var/lib/clickhouse/backups && chown clickhouse:clickhouse /var/lib/clickhouse/backups'
docker compose exec -T clickhouse clickhouse-client \
  --user "${CLICKHOUSE_USER:-default}" --password "${CLICKHOUSE_PASSWORD:-}" \
  --query "BACKUP DATABASE ${CLICKHOUSE_DB:-rybbit} TO File('/var/lib/clickhouse/backups/clickhouse-$stamp.zip')"
mv "<{ clickhouse-data-dir }>/backups/clickhouse-$stamp.zip" "$tmp_dir/clickhouse.zip"

# An archive that exists is not an archive that restores. Load the dump into a
# scratch database and require the schema back, so a truncated or malformed
# dump fails the unit instead of sitting in the bucket looking like a backup.
check_db="rybbit_restore_check_$stamp"
cleanup_check() {
  docker compose exec -T postgres psql -U "${POSTGRES_USER:-rybbit}" -d postgres -q \
    -c "DROP DATABASE IF EXISTS \"$check_db\"" >/dev/null 2>&1 || true
}
trap 'cleanup_check; rm -rf "$tmp_dir"' EXIT
docker compose exec -T postgres psql -U "${POSTGRES_USER:-rybbit}" -d postgres -q -v ON_ERROR_STOP=1 \
  -c "CREATE DATABASE \"$check_db\""
docker compose exec -T postgres psql -U "${POSTGRES_USER:-rybbit}" -d "$check_db" -q -v ON_ERROR_STOP=1 \
  < "$tmp_dir/postgres.sql" >/dev/null
tables=$(docker compose exec -T postgres psql -U "${POSTGRES_USER:-rybbit}" -d "$check_db" -tAc \
  "select count(*) from information_schema.tables where table_schema = 'public'" | tr -d '[:space:]')
if [ "${tables:-0}" -lt 1 ]; then
  echo "restore check restored no tables from postgres.sql" >&2
  exit 1
fi

# Consolidate backup archive
tar -czf "<{ rybbit-backup-dir }>/rybbit-$stamp.tar.gz" -C "$tmp_dir" .

# Upload to R2 via rclone
RCLONE_CONFIG_R2_TYPE=s3 \
RCLONE_CONFIG_R2_PROVIDER=Cloudflare \
RCLONE_CONFIG_R2_REGION=auto \
RCLONE_CONFIG_R2_NO_CHECK_BUCKET=true \
RCLONE_CONFIG_R2_ACCESS_KEY_ID="$RYBBIT_BACKUP_R2_ACCESS_KEY_ID" \
RCLONE_CONFIG_R2_SECRET_ACCESS_KEY="$RYBBIT_BACKUP_R2_SECRET_ACCESS_KEY" \
RCLONE_CONFIG_R2_ENDPOINT="<{ rybbit-backup-r2-endpoint }>" \
rclone copyto "<{ rybbit-backup-dir }>/rybbit-$stamp.tar.gz" \
  "r2:<{ rybbit-backup-r2-bucket }>/<{ profile }>/rybbit-$stamp.tar.gz"

# Retention has to apply to the bucket, not only to this disk: pruning locally
# while R2 keeps every object forever is not a retention policy.
RCLONE_CONFIG_R2_TYPE=s3 \
RCLONE_CONFIG_R2_PROVIDER=Cloudflare \
RCLONE_CONFIG_R2_REGION=auto \
RCLONE_CONFIG_R2_NO_CHECK_BUCKET=true \
RCLONE_CONFIG_R2_ACCESS_KEY_ID="$RYBBIT_BACKUP_R2_ACCESS_KEY_ID" \
RCLONE_CONFIG_R2_SECRET_ACCESS_KEY="$RYBBIT_BACKUP_R2_SECRET_ACCESS_KEY" \
RCLONE_CONFIG_R2_ENDPOINT="<{ rybbit-backup-r2-endpoint }>" \
rclone delete --min-age <{ rybbit-backup-retention-days }>d "r2:<{ rybbit-backup-r2-bucket }>/<{ profile }>"

find <{ rybbit-backup-dir }> -type f -name 'rybbit-*.tar.gz' -mtime +<{ rybbit-backup-retention-days }> -delete
